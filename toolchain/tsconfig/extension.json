{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@osiris/tsconfig/extension",
  "//": "Type-checking config for VS Code extensions. Emit is done by esbuild (CJS bundle); tsc runs with --noEmit.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  }
}
