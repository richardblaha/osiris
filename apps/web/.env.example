# PocketID: issuer URL and the OIDC client ID (public client, PKCE). Redirect URI: <origin>/callback
VITE_OIDC_AUTHORITY=https://id.example.com
VITE_OIDC_CLIENT_ID=
# Development with AUTH_DEV_BYPASS=true on the API: skip PocketID and log in as this user.
VITE_DEV_USER=
# API base URL; empty uses the Vite dev proxy.
VITE_API_URL=
