# Control: tenants, users, schedules, WhatsApp, domains, sites, backups.
# Internal JWT keys: `pnpm --filter @osiris/platform gen-keys` (the same pair in gateway's .env).
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=

# rqlite; without it a local SQLite file (LOCAL_DB_PATH).
RQLITE_URL=
LOCAL_DB_PATH=./data/control.db

# Tenant runtimes run as local child processes (ORCHESTRATOR=local); they inherit this environment, so the model's
# API key goes here too.
MISTRAL_API_KEY=
LLM_MODEL=mistralai:mistral-small-2603

# PocketID admin API; without the key users are kept in memory.
OIDC_ISSUER=
POCKETID_API_KEY=

# Object storage (sites, backups); without S3 a local folder.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_OBJECTS_DIR=./data/objects

# WhatsApp (Meta Cloud API), on when all three are set (plus POCKETID_API_KEY).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# Tenant sites: custom domains must point here (A records) or CNAME to SITES_CNAME_TARGET.
SITES_INGRESS_IPS=
SITES_CNAME_TARGET=
