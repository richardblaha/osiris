{
  "name": "@osiris/control",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate-legacy": "tsx --env-file-if-exists=.env src/legacy/migrate-cli.ts",
    "users": "tsx --env-file-if-exists=.env src/auth/users-cli.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@libsql/client": "0.18.0",
    "@osiris/platform": "workspace:*",
    "@osiris/shared": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "cron-parser": "5.10.1",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "oidc-provider": "9.12.2",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
