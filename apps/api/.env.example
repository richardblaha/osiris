# Each tenant has its own database. Locally: one SQLite file per tenant in this directory.
TENANT_DATA_DIR=./data/tenants
# Production: a Turso database per tenant (<prefix><tenant>), created via the Platform API on first use.
# TURSO_DB_TOKEN is a group token (turso group tokens create <group>) that opens every database in the group.
TURSO_ORG=
TURSO_GROUP=default
TURSO_API_TOKEN=
TURSO_DB_TOKEN=
TURSO_DB_PREFIX=osiris-

# PocketID: issuer URL and the OIDC client ID of the web app (checked as token audience).
# Users and their access live in PocketID as custom claims: role=osiris-user (or osiris-admin: admin of every tenant,
# manages tenants), tenant=<slug> (member), tenant-admin=<slug> (admin; both take comma-separated lists), phone_number.
OIDC_ISSUER=https://id.example.com
OIDC_AUDIENCE=
# Development only: skip OIDC; bearer token "<user>" or "<user>:<group>,<group>". Refused when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# provider:model — install the provider package (@langchain/<provider>) and set its API key
LLM_MODEL=mistralai:mistral-small-2603
EMBEDDING_MODEL=mistralai:mistral-embed
MISTRAL_API_KEY=

CORS_ORIGIN=http://localhost:5173
TIMEZONE=Europe/Prague
# Agent skills: one folder per skill with a SKILL.md (frontmatter name + description, then instructions)
SKILLS_DIR=./skills

# Encrypts MCP server headers at rest: openssl rand -base64 32. Required in production; dev uses a fixed insecure key.
SECRETS_KEY=
# Development only: allow MCP servers on http and private addresses (e.g. localhost). Refused in production.
MCP_ALLOW_PRIVATE=false

# PocketID admin API key (PocketID → Settings → API keys), used at OIDC_ISSUER: tenant members are written as users'
# claims, and WhatsApp finds users by phone. Required in production; without it (development) members are kept in memory.
POCKETID_API_KEY=

# WhatsApp channel (Meta Cloud API), on when all three are set (plus POCKETID_API_KEY).
# Webhook URL: https://<host>/webhooks/whatsapp
# Verify token: any random string, entered in the Meta app's webhook settings too. App secret: Meta app → Settings → Basic.
# Access token: a System User token with whatsapp_business_messaging.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
