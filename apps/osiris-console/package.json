{
  "name": "@richardblaha/osiris-console",
  "version": "0.1.0",
  "private": true,
  "description": "Osiris console — a lightweight SPA for the Kanban backlog, the agent crew and knowledge-base search.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
