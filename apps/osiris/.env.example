# A runtime serves one project. Locally control starts runtimes itself (LocalOrchestrator) with PROJECT_ID, PORT,
# DATA_DIR, CONTROL_URL, INTERNAL_JWT_PUBLIC_KEY and DEV_RUNTIME_AUTH set; the model settings come from control's
# environment. To run one by hand:
PROJECT_ID=acme
PORT=4100
DATA_DIR=./data/acme
CONTROL_URL=http://127.0.0.1:3002
INTERNAL_JWT_PUBLIC_KEY=
DEV_RUNTIME_AUTH=true
MISTRAL_API_KEY=
GOTENBERG_URL=
# Tool modules to load, comma-separated (files, knowledge, memory, skills, database, http, sites, integrations, images, workflows, scheduler, kubernetes, ceph, digital-twin), or all
TOOL_MODULES=all
# The VitePress builder (pnpm dev starts it on :3003): http://localhost:3003
VITEPRESS_URL=
# Development only: let MCP servers and http_request reach http and private addresses.
MCP_ALLOW_PRIVATE=false

# System-only model assignments (provider:model); unset roles inherit LLM_MODEL.
# Supported chat providers: mistralai, openai, anthropic. Set their API keys in the system environment.
LLM_MODEL=mistralai:mistral-small-2603
# LLM_AGENT_MODEL=mistralai:mistral-small-2603
# LLM_TOOLS_MODEL=mistralai:mistral-small-2603
# LLM_GUARD_MODEL=mistralai:mistral-small-2603
# LLM_PERSONA_MODEL=mistralai:mistral-small-2603
EMBEDDING_MODEL=mistralai:mistral-embed

# System-only media processing; uses MISTRAL_API_KEY even when chat uses another provider.
AUDIO_MODEL=voxtral-mini-latest
OCR_MODEL=mistral-ocr-latest

# Optional image tools. Configure the existing comfy-cloud MCP connection in Osiris first (OAuth or vault header).
# Optional bootstrap: sealed into the project vault; does not overwrite existing MCP/OAuth settings.
COMFY_API_KEY=
# Mem0 picks the user's facts from every finished turn into their memory (a few model calls per turn).
MEMORY_LEARN=true
IMAGE_GENERATION_ENABLED=false
IMAGE_MCP_SERVER=comfy-cloud
IMAGE_TIMEOUT_MS=180000
# Exact trusted artifact hosts. Add the provider's actual CDN hostname after checking it; no wildcards.
IMAGE_DOWNLOAD_HOSTS=cloud.comfy.org,storage.googleapis.com
# Hard bounds for paid requests. Refinements are disabled unless explicitly enabled.
IMAGE_MAX_ATTEMPTS=1
IMAGE_MAX_REFINEMENTS=0
# IMAGE_MAX_ESTIMATED_COST=1
IMAGE_MAX_READ_ATTEMPTS=3
IMAGE_MAX_COUNT=16
# Evaluate outputs with the existing multimodal chat model; uses its normal token quota.
IMAGE_VISUAL_EVALUATION=false
# Only needed when MCP upload requires a path unavailable to the remote server.
# Put COMFY_API_KEY in Osiris's project vault, allowed host cloud.comfy.org.
IMAGE_API_UPLOAD_FALLBACK=false
IMAGE_API_KEY_SECRET=COMFY_API_KEY
IMAGE_RETENTION_DAYS=30

# Language of messages when the request names none (WhatsApp replies, e-mails to others, stored notes): en (default) or cs.
DEFAULT_LOCALE=
