    "@osiris/tools-digital-twin": "workspace:*",
    "@osiris/tools-files": "workspace:*",
    "@osiris/tools-http": "workspace:*",
    "@osiris/tools-images": "workspace:*",
    "@osiris/tools-integrations": "workspace:*",
