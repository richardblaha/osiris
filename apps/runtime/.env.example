# A runtime serves one tenant. Locally control starts runtimes itself (LocalOrchestrator) with TENANT_ID, PORT,
# DATA_DIR, CONTROL_URL, INTERNAL_JWT_PUBLIC_KEY and DEV_RUNTIME_AUTH set; the model settings come from control's
# environment. To run one by hand:
TENANT_ID=acme
PORT=4100
DATA_DIR=./data/acme
CONTROL_URL=http://127.0.0.1:3002
INTERNAL_JWT_PUBLIC_KEY=
DEV_RUNTIME_AUTH=true
MISTRAL_API_KEY=
GOTENBERG_URL=
# Development only: let MCP servers and http_request reach http and private addresses.
MCP_ALLOW_PRIVATE=false
