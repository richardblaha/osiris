# Gateway: the only way in (sign-in at /auth and the API to control, the rest to the tenant runtimes).
INTERNAL_JWT_PRIVATE_KEY=
CONTROL_URL=http://127.0.0.1:3002

# Development only: skip sign-in, the bearer token itself becomes the user (see CLAUDE.md). Without it, control's
# OIDC provider signs users in and identifies their tokens.
AUTH_DEV_BYPASS=true
CORS_ORIGIN=http://localhost:5173
# A GoatCounter site the web app counts visits to (e.g. https://osiris.stats.k6labs.cz); empty = no counting.
GOATCOUNTER_URL=

# Trust forwarded client IPs only from these ingress/socket CIDRs. Restrict to actual ingress ranges.
TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32,::1/128
# Optional Cloudflare CIDRs: CF-Connecting-IP is accepted only when the ingress saw a listed CDN address.
CDN_PROXIES=
