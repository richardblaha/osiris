# Gateway: the only way in (OIDC, routing to control and the tenant runtimes).
INTERNAL_JWT_PRIVATE_KEY=
CONTROL_URL=http://127.0.0.1:3002

# PocketID: issuer URL and the OIDC client ID of the web app (checked as token audience).
OIDC_ISSUER=
OIDC_AUDIENCE=
# Development only: skip OIDC, the bearer token itself becomes the user (see CLAUDE.md).
AUTH_DEV_BYPASS=true
CORS_ORIGIN=http://localhost:5173
