{
  "name": "@osiris/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop packaging for Osiris IDE (VSCodium overlay + electron-builder).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:shell": "node scripts/clone-upstream.mjs && node scripts/apply-branding.mjs",
    "build": "node scripts/check-ready.mjs",
    "build:shell": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint scripts runtime",
    "typecheck": "echo \"@osiris/desktop: scripts are plain .mjs, nothing to typecheck\"",
    "test": "node --test \"scripts/**/*.test.mjs\" \"runtime/**/*.test.mjs\"",
    "clean": "rimraf .build dist_electron"
  },
  "dependencies": {
    "@osiris/branding": "workspace:*",
    "@osiris/desktop-host": "workspace:*"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1"
  }
}
