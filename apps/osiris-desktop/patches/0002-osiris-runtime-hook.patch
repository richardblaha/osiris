+// >>> Osiris runtime hook
+import { app as osirisApp } from 'electron';
+import { join as osirisJoin } from 'path';
+osirisApp.whenReady().then(() => {
+	import(osirisJoin(__dirname, '../../../../runtime/osiris-main.mjs'))
+		.then(m => m.activateOsirisRuntime({ app: osirisApp }))
+		.catch(err => console.error('[osiris] runtime hook failed', err));
+});
+// <<< Osiris runtime hook
+
 import { app, dialog } from 'electron';
 import { unlinkSync, promises } from 'fs';
