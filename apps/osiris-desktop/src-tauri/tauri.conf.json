{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osiris",
  "version": "0.1.0",
  "identifier": "cz.k6labs.osiris",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/theme.mjs",
    "beforeDevCommand": "node scripts/theme.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Osiris",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Osiris: the assistant for a project folder or an Osiris server",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
