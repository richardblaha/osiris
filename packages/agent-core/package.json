{
  "name": "@osiris/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic agent loop (Anthropic, OpenAI-compatible, Ollama) plus a portable conversation/task snapshot for session handover.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@osiris/shared-core": "workspace:*"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
