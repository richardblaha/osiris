{
  "name": "@osiris/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A small Model Context Protocol client (stdio + Streamable HTTP), .osiris/mcp.json loading, and an adapter that exposes MCP tools to the Osiris crew.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@osiris/agent-core": "workspace:*",
    "@osiris/dot-osiris": "workspace:*",
    "@osiris/shared-core": "workspace:*"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
