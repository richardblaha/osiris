{
  "name": "@osiris/backlog",
  "version": "0.1.0",
  "private": true,
  "description": "File-based project management for Osiris, kept on a dedicated Git orphan branch so backlog churn never touches source history.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@richardblaha/dot-osiris": "workspace:*",
    "@richardblaha/protocol": "workspace:*",
    "@richardblaha/shared-core": "workspace:*",
    "execa": "^9.5.1"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
