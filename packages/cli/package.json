{
  "name": "@osiris/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `osiris` command line: workspace init, knowledge-base indexing, the agent crew and the Git-backed backlog.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "osiris": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@osiris/backlog": "workspace:*",
    "@osiris/crew": "workspace:*",
    "@osiris/dot-osiris": "workspace:*",
    "@osiris/mcp": "workspace:*",
    "@osiris/memory": "workspace:*",
    "@osiris/protocol": "workspace:*",
    "@osiris/server": "workspace:*",
    "@osiris/shared-core": "workspace:*"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
