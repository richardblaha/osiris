{
  "name": "@richardblaha/osiris-mcp",
  "version": "0.2.0",
  "private": false,
  "description": "A small Model Context Protocol client (stdio + Streamable HTTP), .osiris/mcp.json loading, and an adapter that exposes MCP tools to the Osiris crew.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardblaha/osiris-ai.git",
    "directory": "packages/osiris-mcp"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@richardblaha/osiris-agent-core": "workspace:*",
    "@richardblaha/osiris-config": "workspace:*",
    "@richardblaha/osiris-core": "workspace:*"
  },
  "devDependencies": {
    "@richardblaha/osiris-tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
