{
  "$schema": "./tokens.schema.json",
  "$comment": "Single source of truth for the OSIRIS visual language. Extracted verbatim from docs/preview/ (the interactive design reference). Every generated theme — VS Code, GTK, Qt/Kvantum, GNOME Shell, GRUB, wallpapers — is derived from this file. Keep docs/DESIGN_SYSTEM.md in sync (scripts/check-tokens.sh enforces it).",
  "meta": {
    "name": "OSIRIS",
    "version": "0.2.0",
    "reference": "docs/preview/index.html"
  },
  "font": {
    "$comment": "Fira Code is the single OSIRIS typeface — UI chrome, body text and code all render in it (ligatures on). 'ui' keeps a sans fallback only for glyphs Fira Code lacks (CJK etc). Qt/Plasma has no themeable font hook — set it via kdeglobals (see docs/DESIGN_SYSTEM.md §8).",
    "mono": "Fira Code, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "monoFamily": "Fira Code",
    "ui": "Fira Code, ui-monospace, SFMono-Regular, Menlo, Consolas, -apple-system, Segoe UI, Ubuntu, sans-serif",
    "uiFamily": "Fira Code",
    "ligatures": true
  },
  "radius": {
    "$comment": "VS Code 2026 shape language: no round corners, no pills — everything is square with a slight rounding. Controls (inputs, buttons, rows, tabs) use sm/md (4px), floating surfaces lg/xl (6/8px). There is deliberately no pill token.",
    "xs": 2,
    "sm": 4,
    "md": 4,
    "lg": 6,
    "xl": 8
  },
  "shadow": {
    "window": "0 30px 80px -20px rgba(0,0,0,0.65), 0 8px 24px -8px rgba(0,0,0,0.5)",
    "popup": "0 16px 40px rgba(0,0,0,0.5)"
  },
  "icon": {
    "$comment": "Iconography spec. Official Material Symbols Rounded outlines extracted at weight 300, grade 0, optical size 24, fill 0 into iconography/material_symbols.json. iconography/glyphs.json contains only fallbacks for missing upstream symbols. Generated into VS Code file/product and XDG/GNOME themes.",
    "grid": 24,
    "liveArea": 20,
    "padding": 2,
    "keyline": {
      "square": 18,
      "circle": 20,
      "verticalRect": [16, 20],
      "horizontalRect": [20, 16]
    },
    "strokeEquivalent": 2,
    "cornerRadius": { "outer": 2, "inner": 1 },
    "opticalWeight": 300,
    "grade": 0,
    "opticalSize": 24,
    "style": "Official Material Symbols Rounded paths, weight 300, grade 0, optical size 24, fill 0; custom additions only where upstream has no symbol",
    "reference": "Material Symbols Rounded (https://fonts.google.com/icons)",
    "fileIcon": {
      "$comment": "One value per role; assigned to file families in iconography/map/filetypes.json.",
      "palette": {
        "cyan": "#22c3d6", "rose": "#f0509a", "blue": "#589bf0",
        "green": "#3fb950", "amber": "#d9a441", "red": "#f2585b",
        "violet": "#a684f5", "slate": "#8b949e"
      },
      "default": "#8b949e",
      "folder": { "dark": "#00f2fe", "light": "#0969da" },
      "folderOpen": { "dark": "#79c0ff", "light": "#0550ae" }
    },
    "productIcon": {
      "$comment": "VS Code product icon theme generated as a WOFF icon font from the shared rounded glyph source.",
      "fontId": "osiris-symbols",
      "codepointStart": "0xE000"
    },
    "xdg": {
      "themeName": "Osiris",
      "displayName": "Osiris",
      "inherits": ["Adwaita", "breeze", "gnome", "hicolor"],
      "sizes": [16, 24, 32, 48, 64, 128],
      "categories": ["actions", "apps", "categories", "devices", "emblems", "mimetypes", "places", "status"],
      "categoryColor": {
        "actions": "#8b949e", "apps": "#00f2fe", "categories": "#00f2fe",
        "devices": "#8b949e", "emblems": "#ff2a85", "mimetypes": "#8b949e",
        "places": "#00f2fe", "status": "#8b949e"
      },
      "emblemColor": "#ff2a85"
    }
  },
  "terminal": {
    "$comment": "16-colour ANSI palette + surfaces for VTE terminals (GNOME Terminal, Ptyxis, GNOME Console), Konsole and generic emulators. Mirrors the terminal.ansi* values in the VS Code themes. Generated by scripts/lib/gen_terminal.py.",
    "dark": {
      "background": "#0d1117",
      "foreground": "#e6edf3",
      "cursor": "#00f2fe",
      "cursorForeground": "#04151a",
      "selection": "#21262d",
      "selectionForeground": "#e6edf3",
      "palette": [
        "#161b22", "#ff5555", "#3fb950", "#d29922",
        "#79c0ff", "#ff2a85", "#00f2fe", "#e6edf3",
        "#565f6d", "#ff8787", "#56d364", "#e3b341",
        "#a5d6ff", "#ff6ba9", "#6ff7ff", "#ffffff"
      ]
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#1f2328",
      "cursor": "#0969da",
      "cursorForeground": "#ffffff",
      "selection": "#dde7f3",
      "selectionForeground": "#1f2328",
      "palette": [
        "#1f2328", "#cf222e", "#1a7f37", "#9a6700",
        "#0969da", "#e01a76", "#1b7c83", "#6e7781",
        "#57606a", "#a40e26", "#0f6a2e", "#7d4e00",
        "#0550ae", "#bf1c6e", "#1b7c83", "#1f2328"
      ]
    }
  },
  "accent": {
    "primary": { "dark": "#00f2fe", "light": "#0969da" },
    "primarySoft": { "dark": "rgba(0,242,254,0.14)", "light": "rgba(9,105,218,0.10)" },
    "secondary": { "dark": "#ff2a85", "light": "#e01a76" },
    "secondarySoft": { "dark": "rgba(255,42,133,0.14)", "light": "rgba(224,26,118,0.10)" }
  },
  "state": {
    "info": { "dark": "#00f2fe", "light": "#0969da" },
    "success": { "dark": "#3fb950", "light": "#1a7f37" },
    "warning": { "dark": "#d29922", "light": "#9a6700" },
    "error": { "dark": "#ff5555", "light": "#cf222e" }
  },
  "themes": {
    "dark": {
      "type": "dark",
      "bg": {
        "titlebar": "#0d1117",
        "activitybar": "#0d1117",
        "sidebar": "#161b22",
        "sidebarHeader": "#161b22",
        "editor": "#0d1117",
        "editorGutter": "#0d1117",
        "tabActive": "#0d1117",
        "tabInactive": "#161b22",
        "breadcrumbs": "#0d1117",
        "panel": "#161b22",
        "panelTabs": "#161b22",
        "statusbar": "#161b22",
        "statusbarText": "#e6edf3",
        "minimap": "#161b22",
        "hover": "#21262d",
        "selection": "#21262d",
        "input": "#21262d",
        "badge": "#ff2a85"
      },
      "border": { "subtle": "#21262d", "strong": "#30363d" },
      "text": {
        "primary": "#e6edf3",
        "secondary": "#8b949e",
        "muted": "#565f6d",
        "inverse": "#04151a"
      },
      "syntax": {
        "comment": "#565f6d",
        "string": "#a5d6ff",
        "keyword": "#ff2a85",
        "function": "#00f2fe",
        "type": "#79c0ff",
        "number": "#d29922",
        "punctuation": "#8b949e",
        "variable": "#e6edf3",
        "property": "#ffa198"
      },
      "scrollbar": "#30363d"
    },
    "light": {
      "type": "light",
      "bg": {
        "titlebar": "#ffffff",
        "activitybar": "#f6f8fa",
        "sidebar": "#f6f8fa",
        "sidebarHeader": "#f6f8fa",
        "editor": "#ffffff",
        "editorGutter": "#ffffff",
        "tabActive": "#ffffff",
        "tabInactive": "#eaeef2",
        "breadcrumbs": "#ffffff",
        "panel": "#f6f8fa",
        "panelTabs": "#eaeef2",
        "statusbar": "#f6f8fa",
        "statusbarText": "#1f2328",
        "minimap": "#f6f8fa",
        "hover": "#eaeef2",
        "selection": "#dde7f3",
        "input": "#ffffff",
        "badge": "#e01a76"
      },
      "border": { "subtle": "#eaeef2", "strong": "#d0d7de" },
      "text": {
        "primary": "#1f2328",
        "secondary": "#57606a",
        "muted": "#8c959f",
        "inverse": "#ffffff"
      },
      "syntax": {
        "comment": "#8c959f",
        "string": "#0a3069",
        "keyword": "#e01a76",
        "function": "#0969da",
        "type": "#953800",
        "number": "#0550ae",
        "punctuation": "#57606a",
        "variable": "#1f2328",
        "property": "#cf222e"
      },
      "scrollbar": "#d0d7de"
    }
  },
  "wallpaper": {
    "$comment": "The Neon Sci-Fi set: 10 designs, each in a dark and a light variant (20 masters as PNG under assets/wallpapers/neon/). Raster sources cap out at 2560x1440 — higher resolutions would only upscale. Generated by scripts/generate-wallpapers.py into PNGs + GNOME dynamic XML + KDE packages.",
    "resolutions": ["2560x1440", "1920x1080", "1366x768"],
    "neon": {
      "family": "neon",
      "displayName": "Neon Sci-Fi",
      "designs": [
        "01-portal", "02-horizon", "03-hex", "04-waves", "05-radar",
        "06-pyramid", "07-mesh", "08-orbit", "09-flow", "10-monolith"
      ],
      "variants": ["dark", "light"],
      "palette": {
        "dark":  { "base": "#0d1117", "accent": "#00f2fe", "accentAlt": "#ff2a85", "ink": "#e6edf3" },
        "light": { "base": "#eef2f7", "accent": "#0969da", "accentAlt": "#e01a76", "ink": "#1f2328" }
      }
    }
  }
}
