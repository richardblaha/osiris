{
  "name": "@osiris/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Osiris knowledge base: heading-aware Markdown chunking, content-addressed incremental indexing and a ChromaDB (HNSW) vector store.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@osiris/shared-core": "workspace:*",
    "chromadb": "^3.5.0"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
