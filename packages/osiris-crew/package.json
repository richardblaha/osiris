{
  "name": "@richardblaha/osiris-crew",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent orchestration for Osiris: agent definitions, a coordinator that delegates between specialists, a shared blackboard and bridge tools (memory, backlog).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@richardblaha/osiris-agent-core": "workspace:*",
    "@richardblaha/osiris-config": "workspace:*",
    "@richardblaha/osiris-mcp": "workspace:*",
    "@richardblaha/osiris-memory": "workspace:*",
    "@richardblaha/osiris-protocol": "workspace:*",
    "@richardblaha/osiris-core": "workspace:*"
  },
  "devDependencies": {
    "@richardblaha/osiris-tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
