{
  "name": "@richardblaha/osiris-backlog",
  "version": "0.1.0",
  "private": true,
  "description": "File-based project management for Osiris, kept on a dedicated Git orphan branch so backlog churn never touches source history.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@richardblaha/osiris-config": "workspace:*",
    "@richardblaha/osiris-protocol": "workspace:*",
    "@richardblaha/osiris-core": "workspace:*",
    "execa": "^9.5.1"
  },
  "devDependencies": {
    "@richardblaha/osiris-tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
