{
  "$schema": "https://osiris-ide.dev/schema/crew.json",
  "lead": "architect",
  "defaultModel": "${OSIRIS_MODEL_DEFAULT:-ollama/qwen3:4b}",
  "taskModels": {
    "chat": "${OSIRIS_MODEL_CHAT:-ollama/qwen3:4b}",
    "codegen": "${OSIRIS_MODEL_CODEGEN:-vscode-lm/claude-sonnet-5}",
    "review": "${OSIRIS_MODEL_REVIEW:-vscode-lm/claude-sonnet-5}",
    "tests": "${OSIRIS_MODEL_TESTS:-vscode-lm/claude-sonnet-5}",
    "docs": "${OSIRIS_MODEL_DOCS:-ollama/qwen3:4b}",
    "debug": "${OSIRIS_MODEL_DEBUG:-vscode-lm/claude-sonnet-5}",
    "commit": "${OSIRIS_MODEL_COMMIT:-ollama/qwen3:4b}",
    "planning": "${OSIRIS_MODEL_PLANNING:-vscode-lm/claude-opus-5}",
    "research": "${OSIRIS_MODEL_RESEARCH:-vscode-lm/claude-sonnet-5}"
  },
  "coordinator": {
    "maxDepth": 3,
    "maxIterationsPerAgent": 12,
    "maxDelegationsPerRun": 24
  },
  "providers": {
    "vscode-lm": { "kind": "vscode-lm" },
    "echo": { "kind": "echo" },
    "ollama": {
      "kind": "ollama",
      "endpoint": "${OSIRIS_OLLAMA_URL:-http://localhost:11434}",
      "model": "${OSIRIS_LOCAL_MODEL:-qwen3:4b}"
    }
  }
}
