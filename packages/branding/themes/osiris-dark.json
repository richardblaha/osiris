{
  "name": "Osiris Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#00FFFF",
    "foreground": "#e0e0e0",
    "descriptionForeground": "#a0a0a0",
    "errorForeground": "#FF5555",

    "editor.background": "#121212",
    "editor.foreground": "#e0e0e0",
    "editor.lineHighlightBackground": "#1c1c1c",
    "editor.selectionBackground": "#00FFFF33",
    "editor.inactiveSelectionBackground": "#00FFFF1f",
    "editorCursor.foreground": "#00FFFF",
    "editorWhitespace.foreground": "#2a2a2a",
    "editorLineNumber.foreground": "#5a5a5a",
    "editorLineNumber.activeForeground": "#00FFFF",
    "editorError.foreground": "#FF0000",
    "editorWarning.foreground": "#FFBF00",
    "editorInfo.foreground": "#00FFFF",

    "editorGroupHeader.tabsBackground": "#0d0d0d",
    "tab.activeBackground": "#121212",
    "tab.inactiveBackground": "#0d0d0d",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#8a8a8a",
    "tab.activeBorderTop": "#FF00FF",
    "tab.hoverBackground": "#1c1c1c",

    "activityBar.background": "#0d0d0d",
    "activityBar.foreground": "#e0e0e0",
    "activityBar.inactiveForeground": "#6a6a6a",
    "activityBar.activeBorder": "#FF00FF",
    "activityBarBadge.background": "#00FFFF",
    "activityBarBadge.foreground": "#001414",

    "sideBar.background": "#0f0f0f",
    "sideBar.foreground": "#c8c8c8",
    "sideBarSectionHeader.background": "#141414",
    "sideBarTitle.foreground": "#e0e0e0",

    "statusBar.background": "#0d0d0d",
    "statusBar.foreground": "#c8c8c8",
    "statusBar.noFolderBackground": "#0d0d0d",
    "statusBar.debuggingBackground": "#FF00FF",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.remoteBackground": "#00FFFF",
    "statusBarItem.remoteForeground": "#001414",

    "titleBar.activeBackground": "#0d0d0d",
    "titleBar.activeForeground": "#e0e0e0",
    "titleBar.inactiveBackground": "#0d0d0d",

    "button.background": "#FF00FF",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#ff33ff",
    "button.secondaryBackground": "#1f1f1f",
    "button.secondaryForeground": "#e0e0e0",

    "input.background": "#1a1a1a",
    "input.border": "#333333",
    "inputOption.activeBorder": "#00FFFF",
    "dropdown.background": "#1a1a1a",

    "list.activeSelectionBackground": "#00FFFF26",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#1c1c1c",
    "list.focusOutline": "#00FFFF",

    "badge.background": "#00FFFF",
    "badge.foreground": "#001414",
    "progressBar.background": "#FF00FF",

    "panel.border": "#222222",
    "panelTitle.activeBorder": "#FF00FF",

    "terminal.background": "#0d0d0d",
    "terminal.foreground": "#e0e0e0",
    "terminalCursor.foreground": "#00FFFF",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#FF5555",
    "terminal.ansiGreen": "#00FF00",
    "terminal.ansiYellow": "#FFBF00",
    "terminal.ansiBlue": "#5599ff",
    "terminal.ansiMagenta": "#FF00FF",
    "terminal.ansiCyan": "#00FFFF",
    "terminal.ansiWhite": "#e0e0e0",
    "terminal.ansiBrightBlack": "#4a4a4a",
    "terminal.ansiBrightRed": "#ff8888",
    "terminal.ansiBrightGreen": "#66ff66",
    "terminal.ansiBrightYellow": "#ffd966",
    "terminal.ansiBrightBlue": "#88bbff",
    "terminal.ansiBrightMagenta": "#ff66ff",
    "terminal.ansiBrightCyan": "#66ffff",
    "terminal.ansiBrightWhite": "#ffffff",

    "testing.iconPassed": "#00FF00",
    "testing.iconFailed": "#FF0000",
    "gitDecoration.modifiedResourceForeground": "#FFBF00",
    "gitDecoration.untrackedResourceForeground": "#00FF00"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6a6a6a", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#8affc1" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "keyword.other.unit"],
      "settings": { "foreground": "#ff9d66" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#00FFFF" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#FF66FF" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#66d9ff" }
    },
    {
      "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "#e0e0e0" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#00FFFF" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FF00FF" }
    }
  ]
}
