{
  "name": "@osiris/branding",
  "displayName": "Osiris Branding",
  "version": "1.0.0",
  "description": "Osiris IDE branding: icons, colour themes, product.json overlay and shared asset metadata.",
  "license": "MIT",
  "publisher": "osiris-ide",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./product-overlay": "./product.overlay.json",
    "./metadata": "./assets/metadata.json",
    "./render-icons": "./scripts/render-icons.mjs",
    "./apply-to-checkout": "./scripts/apply-to-checkout.mjs"
  },
  "files": [
    "dist",
    "assets",
    "themes",
    "product.overlay.json",
    "scripts"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "render:icons": "node scripts/render-icons.mjs",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out osiris-branding.vsix",
    "clean": "rimraf dist *.tsbuildinfo *.vsix assets/generated"
  },
  "contributes": {
    "themes": [
      {
        "label": "Osiris Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/osiris-dark.json"
      },
      {
        "label": "Osiris Light",
        "uiTheme": "vs",
        "path": "./themes/osiris-light.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Osiris Dark",
      "editor.fontFamily": "'Fira Code', 'Cascadia Code', Consolas, 'Droid Sans Mono', monospace",
      "editor.fontLigatures": true,
      "terminal.integrated.fontFamily": "'Fira Code', monospace"
    }
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "@vscode/vsce": "^3.1.1",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@fiahfy/icns": "^0.0.7",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  }
}
