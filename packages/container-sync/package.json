{
  "name": "@osiris/container-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Container mobility for Osiris: DevContainer lifecycle (build, template, identity hashing).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devcontainer-template": {
      "types": "./dist/devcontainer-template.d.ts",
      "default": "./dist/devcontainer-template.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.80.0",
    "@richardblaha/protocol": "workspace:*",
    "@richardblaha/shared-core": "workspace:*",
    "execa": "^9.5.0"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
