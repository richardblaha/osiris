{
  "name": "@osiris/container-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Container mobility for Osiris: DevContainer lifecycle, freeze/thaw of a running session, image commit/push and workspace-volume transfer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devcontainer-template": {
      "types": "./dist/devcontainer-template.d.ts",
      "default": "./dist/devcontainer-template.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.80.0",
    "@osiris/protocol": "workspace:*",
    "@osiris/shared-core": "workspace:*",
    "dockerode": "^5.0.1",
    "execa": "^9.5.0"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
