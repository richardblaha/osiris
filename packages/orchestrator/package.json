{
  "name": "@osiris/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight TypeScript replacement for the .NET Aspire AppHost: a declarative StackSpec driven onto Docker via dockerode, with an optional docker-compose renderer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "osiris-orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@osiris/shared-core": "workspace:*",
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@osiris/tsconfig": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
