{
  "name": "osiris-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Osiris AI agent — CLI, kind-operator, API and shared libraries.",
  "license": "MIT",
  "homepage": "https://github.com/richardblaha/osiris-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardblaha/osiris-ai.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "package": "turbo run package",
    "osiris": "node packages/osiris-cli/dist/cli.js",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@richardblaha/osiris-eslint-config": "workspace:*",
    "@richardblaha/osiris-tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
