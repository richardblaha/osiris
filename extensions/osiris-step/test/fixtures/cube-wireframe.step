ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Osiris test wireframe','tiny'),'2;1');
FILE_NAME('cube-wireframe.step','2026-09-01T00:00:00',('Osiris'),('Osiris IDE'),
  'Osiris parser test','Osiris','none');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 }'));
ENDSEC;
DATA;
/* eight corners of a unit cube, referenced forward by the polyline below */
#10 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#11 = CARTESIAN_POINT('',(1.0,0.0,0.0));
#12 = CARTESIAN_POINT('',(1.0,1.0,0.0));
#13 = CARTESIAN_POINT('',(0.0,1.0,0.0));
#14 = CARTESIAN_POINT('',(0.0,0.0,1.0));
#15 = CARTESIAN_POINT('',(1.0,0.0,1.0));
#16 = CARTESIAN_POINT('',(1.0,1.0,1.0));
#17 = CARTESIAN_POINT('',(0.0,1.0,1.0));
#20 = POLYLINE('bottom-loop',(#10,#11,#12,#13,#10));
#21 = POLYLINE('top-loop',(#14,#15,#16,#17,#14));
#30 = VERTEX_POINT('',#10);
#31 = VERTEX_POINT('',#14);
#40 = EDGE_CURVE('pillar',#30,#31,#50,.T.);
#50 = LINE('',#10,#60);
#60 = VECTOR('',#70,1.0);
#70 = DIRECTION('',(0.0,0.0,1.0));
ENDSEC;
END-ISO-10303-21;
