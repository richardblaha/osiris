# Osiris Digital Twin: the k8s cluster's digital twin (structure straight from the Kubernetes API, telemetry from
# ClickHouse, both cached in Redis). Copy to .env and adjust; production requires the https/secret entries.

# The web build the service serves (Docker sets it; in development Vite serves the PWA and proxies here).
PORT=3004
# STATIC_DIR=../web/dist

# Sign-in: osiris-auth's OIDC (the PWA signs in as WEB_CLIENT_ID; the API introspects as AUTH_CLIENT_ID).
# Without AUTH_URL, the API serves everything to anyone (development only; refused in production).
AUTH_URL=http://localhost:3003
WEB_CLIENT_ID=digital-twin
AUTH_CLIENT_ID=osiris-digital-twin
AUTH_CLIENT_SECRET=
AUTH_REQUIRED_GROUP=admin

# The cluster's name in the twin (the 3D view labels the root box with it).
CLUSTER_NAME=busiris

# The Kubernetes API: in the cluster the pod's ServiceAccount (read-only, deploy/k8s/rbac.yaml). For any other
# cluster, give its kubeconfig (a token user: kubectl create token <service-account> --duration 0 for one that
# doesn't expire; the file's certificate authority or insecure-skip-tls-verify is honoured):
# KUBECONFIG=./.kubeconfig
# KUBE_CONTEXT=
# Development without a kubeconfig: a server and a token (kubectl create token osiris-digital-twin).
# KUBE_API_SERVER=https://kubernetes.default.svc
# KUBE_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# KUBE_TOKEN=

# The cluster's telemetry, as the OpenTelemetry Collector's ClickHouse exporter writes it (read-only user): any
# cluster works, as long as its logs, metrics and traces reach ClickHouse's database otel through the collector
# (tables otel_logs, otel_traces, otel_metrics_*). CLICKHOUSE_CLUSTER is the `k8s.cluster.name` its collector stamps
# its telemetry with (the resource/cluster processor), so a ClickHouse shared by several clusters doesn't mix them;
# without it, the queries see every cluster in the database.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=osiris
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_CLUSTER=busiris

# The twin's structure (DTDL models, twins, relationships) in DATA_DIR/twin.db, synced from the source every
# SYNC_INTERVAL_SECONDS. Its history goes out as OpenTelemetry events with the service's telemetry
# (OTEL_EXPORTER_OTLP_ENDPOINT) and is read back from ClickHouse's otel_logs.
DATA_DIR=./data
SYNC_INTERVAL_SECONDS=30
# Telemetry and history answers are cached in the process.
CACHE_DATA_TTL_SECONDS=15
