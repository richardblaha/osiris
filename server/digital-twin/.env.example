# Osiris Digital Twin: the k8s cluster's digital twin (structure straight from the Kubernetes API, telemetry from
# ClickHouse, both cached in Redis). Copy to .env and adjust; production requires the https/secret entries.

# The web build the service serves (Docker sets it; in development Vite serves the PWA and proxies here).
PORT=3004
# STATIC_DIR=../web/dist

# Sign-in: osiris-auth's OIDC (the PWA signs in as WEB_CLIENT_ID; the API introspects as AUTH_CLIENT_ID).
# Without AUTH_URL, the API serves everything to anyone (development only; refused in production).
AUTH_URL=http://localhost:3003
WEB_CLIENT_ID=digital-twin
AUTH_CLIENT_ID=osiris-digital-twin
AUTH_CLIENT_SECRET=
# Members of this group see and manage every twin; members of `twin:<id>` see that twin.
AUTH_ADMIN_GROUP=admin

# The cluster's name in the twin (the 3D view labels the root box with it).
CLUSTER_NAME=busiris

# The Kubernetes API: in the cluster the pod's ServiceAccount (read-only, deploy/k8s/rbac.yaml). For any other
# cluster, give its kubeconfig (a token user: kubectl create token <service-account> --duration 0 for one that
# doesn't expire; the file's certificate authority or insecure-skip-tls-verify is honoured):
# KUBECONFIG=./.kubeconfig
# KUBE_CONTEXT=
# Development without a kubeconfig: a server and a token (kubectl create token osiris-digital-twin).
# KUBE_API_SERVER=https://kubernetes.default.svc
# KUBE_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# KUBE_TOKEN=

# The cluster's telemetry, as the OpenTelemetry Collector's ClickHouse exporter writes it (read-only user): any
# cluster works, as long as its logs, metrics and traces reach ClickHouse's database otel through the collector
# (tables otel_logs, otel_traces, otel_metrics_*). CLICKHOUSE_CLUSTER is the `k8s.cluster.name` its collector stamps
# its telemetry with (the resource/cluster processor), so a ClickHouse shared by several clusters doesn't mix them;
# without it, the queries see every cluster in the database.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=osiris
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_CLUSTER=busiris

# The twin's definitions (DTDL models — the source's plus admins' edits, instances, dashboards, saved filters) in
# DATA_DIR/twin.db (SQLite; no twin data there). Its current state (twins, relationships, the view's telemetry) and
# the answers' cache live in Redis, written by the sync every SYNC_INTERVAL_SECONDS; the collector's twin_events
# processor writes the warn/error stream there. The history goes out as OpenTelemetry events with the service's
# telemetry (OTEL_EXPORTER_OTLP_ENDPOINT) and is read back from ClickHouse's otel_logs.
DATA_DIR=./data
SYNC_INTERVAL_SECONDS=30
# Redis (required in production): the state cache, the answers' cache and the events stream under REDIS_KEY_PREFIX.
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_KEY_PREFIX=osiris
# How long the view's telemetry outlives a sync round (default: 3x SYNC_INTERVAL_SECONDS).
# TELEMETRY_TTL_SECONDS=90
# Telemetry and history answers are cached for this long.
CACHE_DATA_TTL_SECONDS=15
# The alerts service (src/alerts, run with `pnpm --filter @osiris/digital-twin exec tsx src/alerts/index.ts`): the
# twin asks it for its alerts with its ServiceAccount's projected token (ALERTS_TOKEN_PATH), in development with
# ALERTS_TOKEN (the service's ALERTS_DEV_TOKEN). Without ALERTS_URL the twin has no alerts.
# ALERTS_URL=http://localhost:3006
# ALERTS_TOKEN=
#
# The alerts service's own settings (its environment, not the twin's): OSIRIS_URL, OSIRIS_PROJECT, AUTH_URL,
# ALERTS_CLIENT_ID (osiris-twin-alerts), ALERTS_CLIENT_SECRET, REDIS_URL, REDIS_KEY_PREFIX, ALERTS_MIN_SEVERITY,
# ALERTS_REOPEN_MINUTES, ALERTS_MAX_PER_HOUR, ALERTS_RESOLVE_MINUTES, ALERTS_DEV_TOKEN (development only).

# Optional, with their defaults.
# Seals the twins' secrets (kubeconfigs, passwords) in twin.db: 32 bytes base64 (openssl rand -base64 32); required
# in production, development without it uses a fixed key.
# TWIN_SECRETS_KEY=
# Ceph's managers' Prometheus pages (http://<host>:9283/metrics, comma-separated): the twin then shows Ceph.
# CEPH_MANAGERS=
# Osiris's chat over the twin: its gateway (the PWA calls /osiris/api/…) and the project it talks to.
# OSIRIS_URL=http://localhost:3001
# OSIRIS_PROJECT=twin
# The ops API (kubectl, ceph) for the agents of these Osiris projects (comma-separated); a tool whose files are
# missing is off.
# OPS_PROJECTS=
# OPS_KUBE_TOKEN_PATH=/var/run/secrets/osiris-ops/token
# OPS_KUBE_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# OPS_CEPH_CONF=/etc/ceph-ops/ceph.conf
# OPS_CEPH_KEYRING=/etc/ceph-ops/keyring
# OPS_CEPH_USER=client.admin
# Development only (refused in production): any bearer token signs in as `dev`; runtimes are `dev-runtime:<project>`.
# AUTH_DEV_BYPASS=false
# DEV_RUNTIME_AUTH=false
