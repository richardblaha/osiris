# osiris-auth: sign-in (OpenID Connect provider), users and groups (SCIM 2.0 at /scim/v2), its own SQLite in DATA_DIR.
PORT=3003
DATA_DIR=./data
# Where browsers reach it: the issuer.
PUBLIC_URL=http://localhost:3003
# Where the web app runs (comma-separated); each gets <origin>/callback.
WEB_ORIGINS=http://localhost:5173
# The gateway's secret for token introspection (the same in the gateway's .env), at least 32 characters.
GATEWAY_CLIENT_SECRET=
# From `pnpm --filter @osiris/platform gen-keys`; without them development keys are used (kept in DATA_DIR).
AUTH_SIGNING_KEY=
AUTH_SECRET=
# Social sign-in, each on when both are set. Redirect URI: <PUBLIC_URL>/social/<google|facebook|microsoft|seznam>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SEZNAM_CLIENT_ID=
SEZNAM_CLIENT_SECRET=
# Email for sign-in links: Emailit's API key, or smtp(s)://user:pass@host:port. Empty in development prints them.
EMAILIT_API_KEY=
SMTP_URL=
# The built sign-in and account pages (`pnpm --filter @osiris/pwa build`).
STATIC_DIR=../../apps/osiris-pwa/dist
