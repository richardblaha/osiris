# Gateway: the only way in to the API (control, and the rest to the project runtimes); users sign in at osiris-auth.
INTERNAL_JWT_PRIVATE_KEY=
CONTROL_URL=http://127.0.0.1:3002

# Development only: skip sign-in, the bearer token itself becomes the user (see CLAUDE.md). Without it, osiris-auth
# signs users in and introspects their tokens, with the gateway's secret (GATEWAY_CLIENT_SECRET there too).
AUTH_DEV_BYPASS=true
AUTH_URL=http://localhost:3003
GATEWAY_CLIENT_SECRET=
CORS_ORIGIN=http://localhost:5173
# A GoatCounter site the web app counts visits to (e.g. https://osiris.stats.k6labs.cz); empty = no counting.
GOATCOUNTER_URL=

# Trust forwarded client IPs only from these ingress/socket CIDRs. Restrict to actual ingress ranges.
TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32,::1/128
# Optional Cloudflare CIDRs: CF-Connecting-IP is accepted only when the ingress saw a listed CDN address.
CDN_PROXIES=

# Language of messages when the request names none (WhatsApp replies, e-mails to others, stored notes): en (default) or cs.
DEFAULT_LOCALE=
