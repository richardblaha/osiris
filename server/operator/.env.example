# Operator: reconciles Project resources into the runtimes' Deployments (scale to zero, snapshots). Runs in the cluster.
NAMESPACE=osiris
RUNTIME_IMAGE=ghcr.io/richardblaha/osiris-runtime:main
IMAGE_PULL_SECRET=
STORAGE_CLASS=ceph-rbd
CONTROL_URL=https://control.osiris.svc.cluster.local:8080

# The internal JWT key pair and the master key for the projects' secrets (pnpm --filter @osiris/platform gen-keys).
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=
SECRETS_MASTER_KEY=

RESYNC_SECONDS=60
HEALTH_PORT=8081

# Optional: PDF conversion and the project websites' builder, reached by the runtimes.
GOTENBERG_URL=
VITEPRESS_URL=

# The runtimes' own settings pass through from here: RUNTIME_* (plain env) and RUNTIME_SECRET_* (keys),
# e.g. RUNTIME_SECRET_OPENAI_API_KEY= is passed to every runtime as OPENAI_API_KEY.
