# Control: projects and their members, schedules, WhatsApp, backups.
# Internal JWT keys: `pnpm --filter @osiris/platform gen-keys` (the same pair in gateway's .env).
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=

# rqlite; without it a local SQLite file (LOCAL_DB_PATH).
RQLITE_URL=
LOCAL_DB_PATH=./data/control.db

# Project runtimes run as local child processes (ORCHESTRATOR=local); they inherit this environment, so the model's
# API key goes here too.
MISTRAL_API_KEY=
LLM_MODEL=mistralai:mistral-small-2603

# Where the web app runs (links in WhatsApp replies, project logo URLs).
PUBLIC_URL=http://localhost:5173
# osiris-auth keeps users and groups; control changes them over SCIM with its token:
# `pnpm --filter @osiris/auth cli token control`.
AUTH_URL=http://localhost:3003
AUTH_SCIM_TOKEN=
# Email for notices to project admins: smtp(s)://user:pass@host:port, or Emailit's API key (wins). Empty in
# development prints the emails to the log.
SMTP_URL=
EMAILIT_API_KEY=

# Object storage (sites, backups); without S3 a local folder.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_OBJECTS_DIR=./data/objects

# WhatsApp (Meta Cloud API), on when all three are set.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# Project sites: custom domains must point here (A records) or CNAME to SITES_CNAME_TARGET.
SITES_INGRESS_IPS=
SITES_CNAME_TARGET=

# System-only model assignments (provider:model); unset roles inherit LLM_MODEL.
# Supported chat providers: mistralai, openai, anthropic. Set their API keys in the system environment.
# LLM_AGENT_MODEL=mistralai:mistral-small-2603
# LLM_TOOLS_MODEL=mistralai:mistral-small-2603
# LLM_GUARD_MODEL=mistralai:mistral-small-2603
# LLM_PERSONA_MODEL=mistralai:mistral-small-2603
EMBEDDING_MODEL=mistralai:mistral-embed

# Local GeoIP cache (DB-IP City/ASN); client IPs are never sent to an external lookup API.
GEOIP_DIR=/tmp/osiris-geo
GEOIP_AUTO_UPDATE=true

# Published Meta Flows; see deploy/whatsapp/README.md and appointment-flow.json.
WHATSAPP_FLOWS_JSON=[]
# Approved template with one body text parameter, for requested schedule results outside 24 hours.
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=cs

# Language of messages when the request names none (WhatsApp replies, e-mails to others, stored notes): en (default) or cs.
DEFAULT_LOCALE=
