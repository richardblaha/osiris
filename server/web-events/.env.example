# Cookieless web analytics for the projects' websites: one OTLP log record per event, no cookies, no IPs stored.
PORT=8080

# Secret: derives each day's salt for the visitor hashes (at least 32 characters).
SALT_SEED=

# JSON [{ "id": "site-id", "hosts": ["www.example.cz"] }]: the sites allowed to send events (the `data-site` id and the
# host names they are served on).
SITES=[]

# The collector's web analytics receiver (OTLP/HTTP), kept apart from OTEL_EXPORTER_OTLP_ENDPOINT.
WEB_EVENTS_OTLP_URL=http://localhost:4320/v1/logs

# Trust forwarded client IPs only from these ingress/socket CIDRs. Restrict to actual ingress ranges.
TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32,::1/128
# Optional Cloudflare CIDRs: CF-Connecting-IP is accepted only when the ingress saw a listed CDN address.
CDN_PROXIES=

# DB-IP Lite or MaxMind GeoLite2 country database; without it, events carry no country.
GEOIP_DB=/app/geo/country.mmdb
